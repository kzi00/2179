{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Travis Scott Tour Evolution — From Support Act to Stadium Headliner",
  "width": "container",
  "height": 600,
  "padding": {"top": 60, "bottom": 40, "left": 20, "right": 30},
  "background": "#c7bfa6",
  "config": {
    "font": "Georgia, 'Times New Roman', serif",
    "title": {
      "font": "Georgia, 'Times New Roman', serif",
      "fontSize": 0,
      "color": "#2a2a2a"
    },
    "axis": {
      "labelFont": "Georgia, 'Times New Roman', serif",
      "titleFont": "Georgia, 'Times New Roman', serif",
      "labelColor": "#4a4540",
      "titleColor": "#2a2a2a",
      "gridColor": "#b5ad99",
      "gridOpacity": 0.35,
      "domainColor": "#8a8377",
      "tickColor": "#8a8377",
      "labelFontSize": 11.5,
      "titleFontSize": 13,
      "titlePadding": 14
    },
    "legend": {
      "labelFont": "Georgia, 'Times New Roman', serif",
      "titleFont": "Georgia, 'Times New Roman', serif",
      "labelColor": "#4a4540",
      "titleColor": "#2a2a2a",
      "labelFontSize": 11.5,
      "titleFontSize": 12,
      "symbolSize": 100,
      "orient": "top-right",
      "offset": 10,
      "padding": 10
    },
    "view": {
      "stroke": null
    }
  },
  "data": {
    "url": "/data/tours.csv",
    "format": {"type": "csv"}
  },
  "transform": [
    {
      "calculate": "(toNumber(datum.year_start) + toNumber(datum.year_end)) / 2",
      "as": "year_mid"
    },
    {
      "calculate": "toNumber(datum.attendance)",
      "as": "attendance_num"
    },
    {
      "calculate": "toNumber(datum.revenue_millions)",
      "as": "revenue_num"
    },
    {
      "calculate": "toNumber(datum.shows)",
      "as": "shows_num"
    },
    {
      "calculate": "datum.headlining === 'TRUE' ? 'Headlining' : 'Supporting'",
      "as": "role"
    },
    {
      "calculate": "datum.year_start === datum.year_end ? datum.year_start : datum.year_start + '–' + datum.year_end",
      "as": "year_range"
    },
    {
      "calculate": "datum.headlining === 'TRUE' ? datum.tour : datum.tour + ' (' + datum.main_artist + ')'",
      "as": "display_name"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "interpolate": "monotone",
        "strokeWidth": 2.5,
        "opacity": 0.8
      },
      "transform": [{"filter": "datum.role === 'Headlining'"}],
      "encoding": {
        "x": {
          "field": "year_mid",
          "type": "quantitative",
          "scale": {"domain": [2012.5, 2025.5], "nice": false},
          "axis": {
            "title": null,
            "format": "d",
            "tickCount": 13,
            "grid": false,
            "labelAngle": 0
          }
        },
        "y": {
          "field": "attendance_num",
          "type": "quantitative",
          "scale": {"domain": [0, 2300000]},
          "axis": {
            "title": "ATTENDANCE",
            "titleFontWeight": "normal",
            "titleFontSize": 11,
            "format": "~s",
            "tickCount": 6,
            "gridDash": [3, 4]
          }
        },
        "color": {
          "value": "#4c1d95"
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "interpolate": "monotone",
        "strokeWidth": 1.8,
        "opacity": 0.55
      },
      "transform": [{"filter": "datum.role === 'Supporting'"}],
      "encoding": {
        "x": {"field": "year_mid", "type": "quantitative"},
        "y": {"field": "attendance_num", "type": "quantitative"},
        "color": {"value": "#3a3632"}
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 120,
        "opacity": 0.95,
        "stroke": "#c7bfa6",
        "strokeWidth": 2
      },
      "transform": [{"filter": "datum.role === 'Headlining'"}],
      "encoding": {
        "x": {"field": "year_mid", "type": "quantitative"},
        "y": {"field": "attendance_num", "type": "quantitative"},
        "color": {"value": "#4c1d95"},
        "tooltip": [
          {"field": "display_name", "type": "nominal", "title": "Tour"},
          {"field": "year_range", "type": "nominal", "title": "Years"},
          {"field": "attendance_num", "type": "quantitative", "title": "Attendance", "format": ","},
          {"field": "revenue_num", "type": "quantitative", "title": "Revenue ($M)", "format": ".1f"},
          {"field": "shows_num", "type": "quantitative", "title": "Shows"},
          {"field": "role", "type": "nominal", "title": "Role"}
        ]
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 75,
        "opacity": 0.7,
        "stroke": "#c7bfa6",
        "strokeWidth": 1.5,
        "shape": "diamond"
      },
      "transform": [{"filter": "datum.role === 'Supporting'"}],
      "encoding": {
        "x": {"field": "year_mid", "type": "quantitative"},
        "y": {"field": "attendance_num", "type": "quantitative"},
        "color": {"value": "#3a3632"},
        "tooltip": [
          {"field": "display_name", "type": "nominal", "title": "Tour"},
          {"field": "year_range", "type": "nominal", "title": "Years"},
          {"field": "main_artist", "type": "nominal", "title": "Main Artist"},
          {"field": "attendance_num", "type": "quantitative", "title": "Attendance", "format": ","},
          {"field": "revenue_num", "type": "quantitative", "title": "Revenue ($M)", "format": ".1f"},
          {"field": "shows_num", "type": "quantitative", "title": "Shows"},
          {"field": "role", "type": "nominal", "title": "Role"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 14,
        "dy": -14,
        "fontSize": 10,
        "font": "Georgia, 'Times New Roman', serif",
        "fontStyle": "italic",
        "color": "#4c1d95",
        "opacity": 0.8
      },
      "transform": [
        {"filter": "datum.role === 'Headlining'"},
        {"filter": "datum.tour === 'Rodeo Tour'"}
      ],
      "encoding": {
        "x": {"field": "year_mid", "type": "quantitative"},
        "y": {"field": "attendance_num", "type": "quantitative"},
        "text": {"field": "tour", "type": "nominal"}
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 14,
        "dy": 4,
        "fontSize": 10,
        "font": "Georgia, 'Times New Roman', serif",
        "fontStyle": "italic",
        "color": "#4c1d95",
        "opacity": 0.8
      },
      "transform": [
        {"filter": "datum.role === 'Headlining'"},
        {"filter": "datum.tour === 'Birds Eye View Tour'"}
      ],
      "encoding": {
        "x": {"field": "year_mid", "type": "quantitative"},
        "y": {"field": "attendance_num", "type": "quantitative"},
        "text": {"field": "tour", "type": "nominal"}
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 14,
        "dy": 4,
        "fontSize": 10,
        "font": "Georgia, 'Times New Roman', serif",
        "fontStyle": "italic",
        "color": "#4c1d95",
        "opacity": 0.8
      },
      "transform": [
        {"filter": "datum.role === 'Headlining'"},
        {"filter": "datum.tour === 'Astroworld: Wish You Were Here Tour'"}
      ],
      "encoding": {
        "x": {"field": "year_mid", "type": "quantitative"},
        "y": {"field": "attendance_num", "type": "quantitative"},
        "text": {"field": "tour", "type": "nominal"}
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -14,
        "dy": -14,
        "fontSize": 10,
        "font": "Georgia, 'Times New Roman', serif",
        "fontStyle": "italic",
        "color": "#4c1d95",
        "opacity": 0.8
      },
      "transform": [
        {"filter": "datum.role === 'Headlining'"},
        {"filter": "datum.tour === 'Circus Maximus'"}
      ],
      "encoding": {
        "x": {"field": "year_mid", "type": "quantitative"},
        "y": {"field": "attendance_num", "type": "quantitative"},
        "text": {"field": "tour", "type": "nominal"}
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "dx": 0,
        "dy": 18,
        "fontSize": 9,
        "font": "Georgia, 'Times New Roman', serif",
        "fontStyle": "italic",
        "color": "#5a554d",
        "opacity": 0.75
      },
      "transform": [
        {"filter": "datum.role === 'Supporting'"},
        {"filter": "datum.main_artist === 'Kanye West'"}
      ],
      "encoding": {
        "x": {"field": "year_mid", "type": "quantitative"},
        "y": {"field": "attendance_num", "type": "quantitative"},
        "text": {"field": "display_name", "type": "nominal"}
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 14,
        "dy": 0,
        "fontSize": 9,
        "font": "Georgia, 'Times New Roman', serif",
        "fontStyle": "italic",
        "color": "#5a554d",
        "opacity": 0.75
      },
      "transform": [
        {"filter": "datum.role === 'Supporting'"},
        {"filter": "datum.main_artist === 'The Weeknd' && datum.tour === 'The Madness Fall Tour'"}
      ],
      "encoding": {
        "x": {"field": "year_mid", "type": "quantitative"},
        "y": {"field": "attendance_num", "type": "quantitative"},
        "text": {"field": "display_name", "type": "nominal"}
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -14,
        "dy": -14,
        "fontSize": 9,
        "font": "Georgia, 'Times New Roman', serif",
        "fontStyle": "italic",
        "color": "#5a554d",
        "opacity": 0.75
      },
      "transform": [
        {"filter": "datum.role === 'Supporting'"},
        {"filter": "datum.main_artist === 'Rihanna'"}
      ],
      "encoding": {
        "x": {"field": "year_mid", "type": "quantitative"},
        "y": {"field": "attendance_num", "type": "quantitative"},
        "text": {"field": "display_name", "type": "nominal"}
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "dx": 0,
        "dy": 18,
        "fontSize": 9,
        "font": "Georgia, 'Times New Roman', serif",
        "fontStyle": "italic",
        "color": "#5a554d",
        "opacity": 0.75
      },
      "transform": [
        {"filter": "datum.role === 'Supporting'"},
        {"filter": "datum.main_artist === 'Kendrick Lamar'"}
      ],
      "encoding": {
        "x": {"field": "year_mid", "type": "quantitative"},
        "y": {"field": "attendance_num", "type": "quantitative"},
        "text": {"field": "display_name", "type": "nominal"}
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "dx": 14,
        "dy": -14,
        "fontSize": 9,
        "font": "Georgia, 'Times New Roman', serif",
        "fontStyle": "italic",
        "color": "#5a554d",
        "opacity": 0.75
      },
      "transform": [
        {"filter": "datum.role === 'Supporting'"},
        {"filter": "datum.main_artist === 'The Weeknd' && datum.tour === 'Starboy: Legend of the Fall Tour'"}
      ],
      "encoding": {
        "x": {"field": "year_mid", "type": "quantitative"},
        "y": {"field": "attendance_num", "type": "quantitative"},
        "text": {"field": "display_name", "type": "nominal"}
      }
    },
    {
      "mark": {
        "type": "rule",
        "strokeDash": [2, 3],
        "strokeWidth": 1,
        "opacity": 0.25,
        "color": "#2a2a2a"
      },
      "data": {"values": [{"x": 2015}]},
      "encoding": {
        "x": {"field": "x", "type": "quantitative"}
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "dy": -245,
        "fontSize": 9,
        "font": "Georgia, 'Times New Roman', serif",
        "fontWeight": "normal",
        "color": "#6b6259",
        "opacity": 0.6,
        "fontStyle": "italic"
      },
      "data": {"values": [{"x": 2015, "label": "First headlining era"}]},
      "encoding": {
        "x": {"field": "x", "type": "quantitative"},
        "text": {"field": "label", "type": "nominal"}
      }
    },
    {
      "mark": {
        "type": "rule",
        "strokeDash": [2, 3],
        "strokeWidth": 1,
        "opacity": 0.25,
        "color": "#2a2a2a"
      },
      "data": {"values": [{"x": 2018.5}]},
      "encoding": {
        "x": {"field": "x", "type": "quantitative"}
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "dy": -245,
        "fontSize": 9,
        "font": "Georgia, 'Times New Roman', serif",
        "fontWeight": "normal",
        "color": "#6b6259",
        "opacity": 0.6,
        "fontStyle": "italic"
      },
      "data": {"values": [{"x": 2018.5, "label": "Astroworld breakthrough"}]},
      "encoding": {
        "x": {"field": "x", "type": "quantitative"},
        "text": {"field": "label", "type": "nominal"}
      }
    },
    {
      "mark": {
        "type": "rule",
        "strokeDash": [2, 3],
        "strokeWidth": 1,
        "opacity": 0.25,
        "color": "#2a2a2a"
      },
      "data": {"values": [{"x": 2024}]},
      "encoding": {
        "x": {"field": "x", "type": "quantitative"}
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -6,
        "dy": -245,
        "fontSize": 9,
        "font": "Georgia, 'Times New Roman', serif",
        "fontWeight": "normal",
        "color": "#6b6259",
        "opacity": 0.6,
        "fontStyle": "italic"
      },
      "data": {"values": [{"x": 2024, "label": "Stadium-scale dominance"}]},
      "encoding": {
        "x": {"field": "x", "type": "quantitative"},
        "text": {"field": "label", "type": "nominal"}
      }
    }
  ]
}