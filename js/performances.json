{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Travis Scott performances by country, with an all-years summary mode and a year slider mode for 2013-2025.",
  "width": "container",
  "height": 700,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "background": "transparent",
  "padding": {
    "left": 8,
    "right": 8,
    "top": 8,
    "bottom": 8
  },
  "projection": {
    "type": "naturalEarth1",
    "scale": 190
  },
  "params": [
    {
      "name": "mode",
      "value": "all"
    },
    {
      "name": "selectedYear",
      "value": 2025
    }
  ],
  "data": {
    "url": "data/performances.csv"
  },
  "transform": [
    {
      "calculate": "toNumber(datum.year)",
      "as": "year_num"
    },
    {
      "calculate": "toNumber(datum.performances)",
      "as": "performances_num"
    }
  ],
  "datasets": {
    "countryCentroids": [
      {"country": "Argentina", "latitude": -34.6, "longitude": -64.0},
      {"country": "Australia", "latitude": -25.0, "longitude": 133.0},
      {"country": "Austria", "latitude": 47.5, "longitude": 14.5},
      {"country": "Belgium", "latitude": 50.8, "longitude": 4.5},
      {"country": "Brazil", "latitude": -10.0, "longitude": -55.0},
      {"country": "Canada", "latitude": 56.1, "longitude": -106.3},
      {"country": "Chile", "latitude": -35.7, "longitude": -71.0},
      {"country": "China", "latitude": 35.9, "longitude": 104.2},
      {"country": "Colombia", "latitude": 4.6, "longitude": -74.1},
      {"country": "Czech Republic", "latitude": 49.8, "longitude": 15.5},
      {"country": "Denmark", "latitude": 56.2, "longitude": 10.0},
      {"country": "Finland", "latitude": 64.0, "longitude": 26.0},
      {"country": "France", "latitude": 46.2, "longitude": 2.2},
      {"country": "Germany", "latitude": 51.2, "longitude": 10.4},
      {"country": "Greece", "latitude": 39.0, "longitude": 22.0},
      {"country": "Hungary", "latitude": 47.1, "longitude": 19.5},
      {"country": "India", "latitude": 21.1, "longitude": 78.0},
      {"country": "Ireland", "latitude": 53.1, "longitude": -8.0},
      {"country": "Israel", "latitude": 31.0, "longitude": 35.0},
      {"country": "Italy", "latitude": 42.5, "longitude": 12.5},
      {"country": "Japan", "latitude": 36.2, "longitude": 138.3},
      {"country": "Macao", "latitude": 22.2, "longitude": 113.5},
      {"country": "Mexico", "latitude": 23.6, "longitude": -102.5},
      {"country": "Monaco", "latitude": 43.7, "longitude": 7.4},
      {"country": "Morocco", "latitude": 31.8, "longitude": -7.1},
      {"country": "Netherlands", "latitude": 52.1, "longitude": 5.3},
      {"country": "New Zealand", "latitude": -41.0, "longitude": 174.0},
      {"country": "Norway", "latitude": 60.5, "longitude": 8.5},
      {"country": "Poland", "latitude": 52.1, "longitude": 19.4},
      {"country": "Portugal", "latitude": 39.5, "longitude": -8.0},
      {"country": "Puerto Rico", "latitude": 18.2, "longitude": -66.5},
      {"country": "Qatar", "latitude": 25.3, "longitude": 51.2},
      {"country": "Romania", "latitude": 45.9, "longitude": 24.9},
      {"country": "Russia", "latitude": 61.5, "longitude": 105.3},
      {"country": "Saudi Arabia", "latitude": 23.9, "longitude": 45.1},
      {"country": "South Africa", "latitude": -30.6, "longitude": 24.0},
      {"country": "South Korea", "latitude": 36.5, "longitude": 127.8},
      {"country": "Spain", "latitude": 40.4, "longitude": -3.7},
      {"country": "Sweden", "latitude": 60.1, "longitude": 18.6},
      {"country": "Switzerland", "latitude": 46.8, "longitude": 8.2},
      {"country": "Thailand", "latitude": 15.8, "longitude": 100.9},
      {"country": "United Arab Emirates", "latitude": 24.4, "longitude": 54.4},
      {"country": "United Kingdom", "latitude": 54.0, "longitude": -2.0},
      {"country": "United States", "latitude": 39.8, "longitude": -98.6}
    ]
  },
  "layer": [
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/vega-datasets@2/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#696969",
        "stroke": "#8C8C8C",
        "strokeWidth": 0.8
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "performances_num",
              "as": "total_performances"
            }
          ],
          "groupby": ["country"]
        },
        {
          "lookup": "country",
          "from": {
            "data": {
              "name": "countryCentroids"
            },
            "key": "country",
            "fields": ["latitude", "longitude"]
          },
          "as": ["latitude", "longitude"]
        }
      ],
      "mark": {
        "type": "circle",
        "fill": "#2b005f",
        "fillOpacity": 0.7,
        "stroke": "rgba(232, 227, 211, 0.8)",
        "strokeWidth": 1.1
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "total_performances",
          "type": "quantitative",
          "legend": null,
          "scale": {
            "range": [40, 2200]
          }
        },
        "opacity": {
          "condition": {
            "test": "mode === 'all'",
            "value": 0.58
          },
          "value": 0
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "total_performances",
            "type": "quantitative",
            "title": "Total Performances",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year_num === selectedYear"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "performances_num",
              "as": "total_performances"
            }
          ],
          "groupby": ["country", "year_num"]
        },
        {
          "lookup": "country",
          "from": {
            "data": {
              "name": "countryCentroids"
            },
            "key": "country",
            "fields": ["latitude", "longitude"]
          },
          "as": ["latitude", "longitude"]
        }
      ],
      "mark": {
        "type": "circle",
        "fill": "#2b005f",
        "fillOpacity": 0.58,
        "stroke": "rgba(255, 255, 255, 0.88)",
        "strokeWidth": 1.1
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "total_performances",
          "type": "quantitative",
          "legend": null,
          "scale": {
            "range": [40, 2200]
          }
        },
        "opacity": {
          "condition": {
            "test": "mode === 'year'",
            "value": 0.58
          },
          "value": 0
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "year_num",
            "type": "quantitative",
            "title": "Year"
          },
          {
            "field": "total_performances",
            "type": "quantitative",
            "title": "Total Performances",
            "format": ",.0f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}