{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Travis Scott First-Week Album-Equivalent Units. Visualises commercial impact of each studio release and compilation across his career.",
  "width": "container",
  "height": 480,
  "background": "rgba(176, 169, 153, 0.65)",
  "border": "1px solid rgba(255, 255, 255, 0.2)",
  "padding": {"left": 40, "right": 40, "top": 60, "bottom": 100},
  "data": {
    "url": "data/first_week_sales.csv"
  },
  "transform": [
    {
      "calculate": "datum.first_week_units / 1000",
      "as": "units_thousands"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 2,
        "width": {"band": 0.55}
      },
      "encoding": {
        "x": {
          "field": "album",
          "type": "nominal",
          "sort": null,
          "axis": {
            "labelAngle": 0,
            "labelFont": "Arial",
            "labelFontSize": 11,
            "labelColor": "#4a4540",
            "labelLineHeight": 13,
            "labelPadding": 12,
            "labelExpr": "split(datum.value, '|')",
            "title": "Album Name",
            "titleFont": "Arial",
            "titleFontSize": 11,
            "titleFontWeight": 600,
            "titleColor": "#4a4540",
            "titlePadding": 12,
            "domain": false,
            "ticks": false
          }
        },
        "y": {
          "field": "units_thousands",
          "type": "quantitative",
          "axis": {
            "title": "First-week album-equivalent units (thousands)",
            "titleFont": "Arial",
            "titleFontSize": 11,
            "titleFontWeight": 600,
            "titleColor": "#4a4540",
            "titlePadding": 12,
            "labelFont": "Arial",
            "labelFontSize": 10,
            "labelColor": "#4a4540",
            "grid": true,
            "gridColor": "#d4cfbf",
            "gridOpacity": 0.5,
            "domain": false,
            "ticks": false,
            "format": "d"
          }
        },
        "color": {"value": "#32006e"},
        "opacity": {
          "condition": {
            "test": "datum.is_highlight === 'true' || datum.is_highlight === true",
            "value": 1.0
          },
          "value": 0.55
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "bottom",
        "dy": -8,
        "font": "Arial",
        "fontSize": 10,
        "fontWeight": 600,
        "color": "#4a4540"
      },
      "encoding": {
        "x": {
          "field": "album",
          "type": "nominal",
          "sort": null
        },
        "y": {
          "field": "units_thousands",
          "type": "quantitative"
        },
        "text": {
          "field": "units_thousands",
          "type": "quantitative",
          "format": ".0f"
        }
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "axis": {"labelFont": "Arial", "titleFont": "Arial", "labelColor": "#4a4540", "titleColor": "#4a4540"}
  }
}