            "titleFont": "Arial",
            "labelColor": "#4a4540",
            "titleColor": "#4a4540",
            "titlePadding": 30
          },
          "scale": {"domain": ["2016-07-01", "2026-06-30"], "nice": false}
        },
        "y": {"field": "category", "type": "nominal", "axis": {"title": "Category", "labelFont": "Arial", "titleFont": "Arial", "labelColor": "#4a4540", "titleColor": "#4a4540"}},
