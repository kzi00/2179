          {"field": "year", "type": "quantitative", "title": "Year"},
          {"field": "gdelt_peak_num", "type": "quantitative", "title": "GDELT Score"}
        ]
      }
    },
    {
      "transform": [
        {"filter": "datum.log_peak >= 0.03 || datum.brand === 'Dior' || datum.brand === 'WWE' || datum.brand === 'Spotify' || datum.brand === 'A24 Films' || (datum.brand === 'Nike' && datum.year >= 2023)"},
        {"calculate": "datum.brand === 'A24 Films' ? 'A24' : datum.brand", "as": "brand_label_top"},
        {"calculate": "datum.brand === 'A24 Films' ? 'Films' : ''", "as": "brand_label_bottom"}
      ],
      "mark": {"type": "text", "dy": 0, "font": "Arial", "fontSize": 8, "fontWeight": 600, "fill": "#404040", "limit": 90},
