  "transform": [
    {"calculate": "toDate(datum.year + '-' + (datum.month < 10 ? '0' + datum.month : datum.month) + '-01')", "as": "date"},
    {"calculate": "toNumber(datum.gdelt_peak)", "as": "gdelt_peak_num"},
    {"calculate": "log(datum.gdelt_peak_num + 1)", "as": "log_peak"}
  ],
  "layer": [
    {
      "mark": {"type": "circle", "opacity": 0.92, "fillOpacity": 0.78, "stroke": "#3a3a3a", "strokeWidth": 1.1},
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "axis": {
            "title": "Year",
            "format": "%Y",
            "labelAngle": 0,
            "grid": false,
            "values": ["2016-01-01", "2017-01-01", "2018-01-01", "2019-01-01", "2020-01-01", "2021-01-01", "2022-01-01", "2023-01-01", "2024-01-01", "2025-01-01"],
